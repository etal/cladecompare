# Generated directories
build
dist
.DS_Store
.directory

# Python packaging, environments and tool caches
__pycache__/
*.egg-info/
.venv/
.pixi/
.pytest_cache/
.ruff_cache/

# Compiled Python files
*.pyc
*.pyo

# Backup files from some editors
*~
*.swp
*.bak
.idea
*.iml

# Patches and any original files created by patch command
*.diff
*.patch
*.orig
*.rej

# Configuration for AI coding harnesses this project does not run. Refusing a
# harness is the same in every clone, so it belongs here rather than in a
# personal exclude file. Directories for a harness someone does use are their
# own business and stay out of this list.
.claude/
.codex/
