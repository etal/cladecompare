# PyMOL script -- A

# Load the pdb file
load 1HCK.pdb, 1hckA
hide all


# ----------------------------------------------------------------------


create MainStruct_1hckA, 1hckA and chain A 
show cartoon, MainStruct_1hckA
color smudge, MainStruct_1hckA 
set cartoon_transparency=0.3, MainStruct_1hckA



